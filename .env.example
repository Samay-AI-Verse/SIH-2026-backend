# ========================================================
# SIH 2026 FastAPI Backend Configuration
# ========================================================

# App & Server
APP_NAME="SIH 2026 Hackathon API"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Admin Credentials (for /admin panel)
ADMIN_EMAIL="sih@gtmcnanded.in"
ADMIN_PASSWORD="SihGtmc2026!"
SECRET_KEY="sih-2026-super-secret-key-change-this-in-production"

# Database Configuration (SQLite local or Cloudflare D1 connection)
DATABASE_URL="sqlite:///./sih_2026.db"

# ========================================================
# CLOUDFLARE R2 OBJECT STORAGE (10 GB FREE STORAGE)
# ========================================================
# 1. Go to https://dash.cloudflare.com/ -> R2 -> Create Bucket (e.g. sih-storage)
# 2. Account ID is found in the right sidebar of Cloudflare R2
# 3. Create API Token (Manage R2 API Tokens -> Create API Token -> Object Read & Write)
# 4. Paste keys below:
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET="sih-storage"
R2_PUBLIC_DOMAIN="https://pub-your-bucket-id.r2.dev" # (Optional: enable public access on bucket)
